@prefix : <__ONTOLOGY_IRI__#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    Ontology
#################################################################

<__ONTOLOGY_IRI__> a owl:Ontology ;
    rdfs:label "NVA Approval ontology" ;
    rdfs:comment "Vocabulary for approvals in NVA. The ontology is versioned with semantic versioning. The namespace and term IRIs are stable across versions: breaking changes introduce new terms and deprecate old ones instead of changing their meaning. Every version is served at its version IRI and never changes once published, while the ontology IRI always serves the latest version." ;
    vann:preferredNamespacePrefix "approval" ;
    vann:preferredNamespaceUri "__ONTOLOGY_IRI__#" ;
    owl:versionIRI <__ONTOLOGY_IRI__/1.0.0> ;
    owl:versionInfo "1.0.0" .

#################################################################
#    Classes
#################################################################

:Approval a rdfs:Class ;
    rdfs:label "Approval" ;
    rdfs:comment "An approval record that associates a persistent handle identifier with a source URI and named identifiers" .

:Identifier a rdfs:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "An identifier used to reference an approval, consisting of a namespace and a value. A value is unique within its namespace across all approvals in the system, while the same value may exist in another namespace." .

#################################################################
#    Properties
#################################################################

:identifiers a rdf:Property ;
    rdfs:label "identifiers" ;
    rdfs:comment "Links an approval to its named identifiers" ;
    rdfs:domain :Approval ;
    rdfs:range :Identifier .

:source a rdf:Property ;
    rdfs:label "source" ;
    rdfs:comment "The source URI that the approval originates from" ;
    rdfs:domain :Approval ;
    rdfs:range xsd:anyURI .

:handle a rdf:Property ;
    rdfs:label "handle" ;
    rdfs:comment "The persistent handle URI assigned to the approval, using the Handle System (handle.net). URIs are in the format https://hdl.handle.net/{prefix}/{suffix}." ;
    rdfs:domain :Approval ;
    rdfs:range xsd:anyURI .

:namespace a rdf:Property ;
    rdfs:label "namespace" ;
    rdfs:comment "The namespace the identifier value belongs to, e.g. REK or DMP. A value is unique within its namespace, but the same value may exist in another namespace. Serialized as the JSON field name." ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string .

:value a rdf:Property ;
    rdfs:label "value" ;
    rdfs:comment "The identifier value, unique within its namespace" ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string .

:approvalId a rdf:Property ;
    rdfs:label "approvalId" ;
    rdfs:comment "The unique UUID identifier of the approval" ;
    rdfs:domain :Approval ;
    rdfs:range xsd:string .
