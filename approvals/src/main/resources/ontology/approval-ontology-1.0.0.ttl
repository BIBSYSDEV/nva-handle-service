@prefix : <__ONTOLOGY_IRI__#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix hydra: <http://www.w3.org/ns/hydra/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    Ontology
#################################################################

<__ONTOLOGY_IRI__> a owl:Ontology ;
    rdfs:label "NVA Approval ontology" ;
    rdfs:comment "Vocabulary for approvals in NVA. The ontology is versioned with semantic versioning. The namespace and term IRIs are stable across versions: breaking changes introduce new terms and deprecate old ones instead of changing their meaning. Every version is served at its version IRI and never changes once published, while the ontology IRI always serves the latest version." ;
    vann:preferredNamespacePrefix "approval" ;
    vann:preferredNamespaceUri "__ONTOLOGY_IRI__#" ;
    owl:versionIRI <__ONTOLOGY_IRI__/1.0.0> ;
    owl:versionInfo "1.0.0" .

#################################################################
#    Classes
#################################################################

:Approval a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Approval" ;
    rdfs:comment "An approval record that associates a persistent handle identifier with a source URI and named identifiers" .

:Identifier a rdfs:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "An identifier used to reference an approval, consisting of a namespace and a value. A value is unique within its namespace across all approvals in the system, while the same value may exist in another namespace." .

:ChangeList a rdfs:Class ;
    rdfs:subClassOf prov:Collection ;
    rdfs:label "ChangeList" ;
    rdfs:comment "A page of the recorded changes to an approval" .

:ApprovalSearchResults a rdfs:Class ;
    rdfs:subClassOf hydra:Collection ;
    rdfs:label "ApprovalSearchResults" ;
    rdfs:comment "A page of the approvals matching a search" .

:ApprovalRevision a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "ApprovalRevision" ;
    rdfs:comment "A version of an approval, recorded every time the approval is created or updated" .

:SourceSnapshot a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "SourceSnapshot" ;
    rdfs:comment "A version of the approval's source, taken when a source change was ingested" .

:ApprovalCreation a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "ApprovalCreation" ;
    rdfs:comment "The activity that created an approval and generated its first revision" .

:ApprovalUpdate a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "ApprovalUpdate" ;
    rdfs:comment "The activity that updated an approval and generated a new revision" .

:SourceIngestion a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "SourceIngestion" ;
    rdfs:comment "The activity that fetched the approval's source and generated a source snapshot" .

:SourceChangedEvent a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "SourceChangedEvent" ;
    rdfs:comment "The event a source reported to say that the resource behind an approval changed, which started a source ingestion" .

:ClinicalTrialView a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "ClinicalTrialView" ;
    rdfs:comment "A view of a clinical trial for presenting an approval, derived from a source snapshot. Values are passed through from the source as-is." .

:Status a rdfs:Class ;
    rdfs:label "Status" ;
    rdfs:comment "The status of a clinical trial in one region" .

:Sponsor a rdfs:Class ;
    rdfs:label "Sponsor" ;
    rdfs:comment "A sponsor of a clinical trial" .

:TrialSite a rdfs:Class ;
    rdfs:label "TrialSite" ;
    rdfs:comment "A site where a clinical trial is carried out, linked to its organization with prov:agent" .

:Investigator a rdfs:Class ;
    rdfs:label "Investigator" ;
    rdfs:comment "The investigator role at a trial site, linked to the person with prov:agent. Title, names and department are as stated by the source." .

:Event a rdfs:Class ;
    rdfs:label "Event" ;
    rdfs:comment "An event in the life of a clinical trial. Each event is typed by the source with a class in this namespace, e.g. TrialStart, which is not declared here because the source decides the set." .

#################################################################
#    Properties
#################################################################

:identifiers a rdf:Property ;
    rdfs:label "identifiers" ;
    rdfs:comment "Links an approval to its named identifiers" ;
    rdfs:domain :Approval ;
    rdfs:range :Identifier .

:source a rdf:Property ;
    rdfs:label "source" ;
    rdfs:comment "The source URI that the approval originates from" ;
    rdfs:domain :Approval ;
    rdfs:range xsd:anyURI .

:handle a rdf:Property ;
    rdfs:label "handle" ;
    rdfs:comment "The persistent handle URI assigned to the approval, using the Handle System (handle.net). URIs are in the format https://hdl.handle.net/{prefix}/{suffix}." ;
    rdfs:domain :Approval ;
    rdfs:range xsd:anyURI .

:namespace a rdf:Property ;
    rdfs:label "namespace" ;
    rdfs:comment "The namespace the identifier value belongs to, e.g. REK or DMP. A value is unique within its namespace, but the same value may exist in another namespace. Serialized as the JSON field name." ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string .

:value a rdf:Property ;
    rdfs:label "value" ;
    rdfs:comment "The identifier value, unique within its namespace" ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string .

:approvalId a rdf:Property ;
    rdfs:label "approvalId" ;
    rdfs:comment "The unique UUID identifier of the approval" ;
    rdfs:domain :Approval ;
    rdfs:range xsd:string .

:title a rdf:Property ;
    rdfs:label "title" ;
    rdfs:comment "The title of the approval, taken from its source" ;
    rdfs:domain :Approval ;
    rdfs:range xsd:string .

:person a rdf:Property ;
    rdfs:label "person" ;
    rdfs:comment "A person associated with the approval" ;
    rdfs:domain :Approval ;
    rdfs:range xsd:string .

:organization a rdf:Property ;
    rdfs:label "organization" ;
    rdfs:comment "An organization associated with the approval" ;
    rdfs:domain :Approval ;
    rdfs:range xsd:string .

:regionStatus a rdf:Property ;
    rdfs:label "regionStatus" ;
    rdfs:comment "The status of the clinical trial in a region" ;
    rdfs:domain :ClinicalTrialView ;
    rdfs:range :Status .

:region a rdf:Property ;
    rdfs:label "region" ;
    rdfs:comment "The region a status or an event applies to, as named by the source" ;
    rdfs:range xsd:string .

:status a rdf:Property ;
    rdfs:label "status" ;
    rdfs:comment "The status value as named by the source" ;
    rdfs:domain :Status ;
    rdfs:range xsd:string .

:event a rdf:Property ;
    rdfs:label "event" ;
    rdfs:comment "An event in the life of the clinical trial in a region. Its type is named by the source, e.g. TrialStart." ;
    rdfs:domain :ClinicalTrialView ;
    rdfs:range :Event .

:date a rdf:Property ;
    rdfs:label "date" ;
    rdfs:comment "The date of an event" ;
    rdfs:range xsd:date .

:trialSite a rdf:Property ;
    rdfs:label "trialSite" ;
    rdfs:comment "A site where the clinical trial is carried out" ;
    rdfs:domain :ClinicalTrialView ;
    rdfs:range :TrialSite .

:departmentName a rdf:Property ;
    rdfs:label "departmentName" ;
    rdfs:comment "The name of the trial site as stated by the source" ;
    rdfs:domain :TrialSite ;
    rdfs:range xsd:string .

:investigator a rdf:Property ;
    rdfs:label "investigator" ;
    rdfs:comment "The investigator role at the trial site" ;
    rdfs:domain :TrialSite ;
    rdfs:range :Investigator .

:department a rdf:Property ;
    rdfs:label "department" ;
    rdfs:comment "The department of the investigator as stated by the source" ;
    rdfs:domain :Investigator ;
    rdfs:range xsd:string .
